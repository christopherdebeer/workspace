{
  "name": "workspace",
  "version": "1.0.0",
  "bin": {
    "workspace": "bin/workspace.js"
  },
  "scripts": {
    "build": "npm run build:web && tsc && cp -r scripts dist/scripts",
    "build:web": "npm --prefix frontend run build",
    "build:test": "npm run build && npm run test:e2e",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "node bin/deploy.js",
    "destroy": "cdk destroy",
    "postinstall": "npm --prefix frontend install && playwright install chromium"
  },
  "dependencies": {
    "aws-cdk": "^2.136.0",
    "aws-cdk-lib": "^2.136.0",
    "aws-sdk": "^2.1692.0",
    "constructs": "^10.3.0",
    "fido2-lib": "^3.5.3",
    "mime-types": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.5",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
