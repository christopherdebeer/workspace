{
  "name": "workspace",
  "version": "1.0.0",
  "bin": {
    "workspace": "bin/workspace.js"
  },
  "scripts": {
    "build": "tsc && npm run typecheck:client && cp -r scripts dist/scripts",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "node bin/deploy.js",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.1",
    "aws-cdk": "^2.136.0",
    "aws-cdk-lib": "^2.136.0",
    "aws-sdk": "^2.1692.0",
    "constructs": "^10.3.0",
    "esbuild-wasm": "^0.25.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.5",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
