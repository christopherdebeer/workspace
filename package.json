{
  "name": "workspace",
  "version": "1.0.0",
  "bin": {
    "workspace": "bin/workspace.js"
  },
  "scripts": {
    "build": "npm run build:web && tsc",
    "build:web": "npm --prefix frontend run build",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "node bin/deploy.js",
    "destroy": "cdk destroy",
    "postinstall": "npm --prefix frontend install"
  },
  "dependencies": {
    "aws-cdk": "^2.136.0",
    "aws-cdk-lib": "^2.136.0",
    "aws-sdk": "^2.1692.0",
    "constructs": "^10.3.0",
    "fido2-lib": "^3.5.3",
    "mime-types": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
