{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom", "node"],
    "noEmit": true
  },
  "include": ["client/**/*.ts", "client/**/*.tsx", "shared/**/*.ts", "shared/**/*.tsx", "shared.tsx"]
}
