{
  "reads": [
    { "as": "layout", "target": "workspace.peek", "input": { "key": "_home/layout" } },
    { "as": "facts", "target": "workspace.query", "input": { "limit": 1 } },
    { "as": "cells", "target": "workspace.query", "input": { "prefix": "cells/", "limit": 1 } },
    { "as": "views", "target": "workspace.views", "input": {} },
    { "as": "links", "target": "workspace.links", "input": {} },
    { "as": "changes", "target": "workspace.changes", "input": { "recent": 1000 } }
  ]
}
