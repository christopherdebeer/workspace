{
  "types": [
    {
      "type": "machine",
      "icon": "🔄",
      "label": "value.title",
      "manager": "@c15r/machine",
      "schema": {
        "title": "string",
        "source": "string? — original .dy text",
        "nodes": "node[]",
        "arrows": "arrow[] — {from, arrow, to} where arrow → edge rel",
        "rails": "rail[] — {from, to, mode, condition?} the executable transitions; projected to _actions/machine.<name>.* declared actions"
      },
      "handlers": {
        "render": [{ "hint": "fields" }]
      }
    },
    {
      "type": "machine-node",
      "icon": "⬡",
      "label": "value.name",
      "manager": "@c15r/machine",
      "schema": {
        "name": "string",
        "kind": "string — Task/State/Input/Output/Context/Resource/Process/Concept/Implementation/Result/tool",
        "attributes": "object?"
      },
      "handlers": {
        "render": [{ "hint": "fields" }]
      }
    },
    {
      "type": "machine-run",
      "icon": "▶️",
      "label": "value.node",
      "manager": "@c15r/machine",
      "schema": {
        "machine": "string — the machine being run",
        "node": "string — the run's current node",
        "status": "'running' | 'done'",
        "at": "string? — ISO time of the last transition"
      },
      "handlers": {
        "render": [{ "hint": "fields" }]
      }
    },
    {
      "type": "rail",
      "icon": "🛤️",
      "label": "value.from",
      "manager": "@c15r/machine",
      "schema": {
        "from": "string",
        "to": "string",
        "mode": "'auto' (deterministic, no LLM) | 'agent' (reasoning required)",
        "condition": "string?"
      },
      "handlers": {
        "render": [{ "hint": "fields" }]
      }
    },
    {
      "type": "meta-tool",
      "icon": "🔧",
      "label": "value.name",
      "manager": "@c15r/machine",
      "schema": {
        "name": "string",
        "strategy": "'agent_backed' | 'code_generation' | 'composition'",
        "implementation": "string"
      },
      "handlers": {
        "render": [{ "hint": "fields" }]
      }
    }
  ]
}
