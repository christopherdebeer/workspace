{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "three": [
        "node_modules/@types/three"
      ]
    }
  },
  "include": [
    "../client/**/*.ts",
    "client-entry.ts",
    "capacitor.config.ts"
  ]
}
