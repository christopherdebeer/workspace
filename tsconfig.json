{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": ["bin", "lib", "platform", "services"],
  "// exclude": "Client-side React (*.tsx) is type-checked by tsconfig.client.json and bundled by esbuild; keep it out of the server (no-DOM/no-JSX) compile.",
  "exclude": ["node_modules", "dist", "cdk.out", "**/*.tsx"]
}
